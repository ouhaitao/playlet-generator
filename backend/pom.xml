<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>org.playlet</groupId>
  <artifactId>playlet-parent</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>pom</packaging>
  <name>playlet-parent</name>
  <description>短剧生成平台 - 父工程</description>

  <modules>
    <module>playlet-domain</module>
    <module>playlet-llm</module>
    <module>playlet-comfyui</module>
    <module>playlet-media</module>
    <module>playlet-agent</module>
    <module>playlet-api</module>
  </modules>

  <properties>
    <java.version>21</java.version>
    <maven.compiler.release>21</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <spring-boot.version>4.1.2</spring-boot.version>
    <spring-ai.version>2.0.2</spring-ai.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-dependencies</artifactId>
        <version>${spring-boot.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>org.springframework.ai</groupId>
        <artifactId>spring-ai-bom</artifactId>
        <version>${spring-ai.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>

      <dependency>
        <groupId>org.playlet</groupId>
        <artifactId>playlet-domain</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>org.playlet</groupId>
        <artifactId>playlet-llm</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>org.playlet</groupId>
        <artifactId>playlet-comfyui</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>org.playlet</groupId>
        <artifactId>playlet-media</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>org.playlet</groupId>
        <artifactId>playlet-agent</artifactId>
        <version>${project.version}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.springframework.boot</groupId>
          <artifactId>spring-boot-maven-plugin</artifactId>
          <version>${spring-boot.version}</version>
        </plugin>
      </plugins>
    </pluginManagement>
  </build>
</project>
